Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Plot", " ", "predicted", " ", "price", " ", "evolution", " ", 
     RowBox[{"(", "USD", ")"}]}], " ", ":"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ticksVPrice", "[", 
     RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"\"\<$\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"IntegerPart", "[", 
           RowBox[{"i", "/", "1000"}], "]"}], "]"}], "<>", "\"\<K\>\""}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "min", ",", " ", "max", ",", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"IntegerPart", "[", 
            RowBox[{"max", "/", "100000"}], "]"}]}], "]"}], "10000"}]}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", 
