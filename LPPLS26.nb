Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "price", " ", "is", " ", "the", " ", "ratio", " ", "of", " ", 
    "the", " ", "market", " ", "cap", " ", 
    RowBox[{"(", 
     RowBox[{"in", " ", "Millions", " ", "USD"}], ")"}], " ", "to", " ", 
    "the", " ", 
    RowBox[{"(", "predicted", ")"}], " ", "supply", " ", "at", " ", "the", 
    " ", 
    RowBox[{"date", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"mToPrice", "[", 
    RowBox[{"m_", ",", " ", "date_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"mToMarketCap", "[", "m", "]"}], 
    RowBox[{
     SuperscriptBox["10", "7"], "/", 
     RowBox[{"supplyFunction", "[", 
      RowBox[{"UnixTime", "[", "date", "]"}], "]"}]}]}]}]}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"f16c0c4e-da0e-4dac-bac1-0ef6975d5c9b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tcToDate", "[", "tc_", "]"}], ":=", " ", 
  RowBox[{"DatePlus", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"bubblesDate", "[", 
      RowBox[{"[", "bubble", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"bubblesDays", "[", 
      RowBox[{"[", "bubble", "]"}], "]"}], 
     RowBox[{"tc", "/", "lastScaledTc"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"tcToDate", "[", "lastScaledTc", "]"}]}], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"3acf0b8c-44e6-4f1d-ab84-ddc204774038"],

