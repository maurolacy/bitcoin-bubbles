                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ">=", " ", "t1"}], 
                    "&"}]}], "]"}], ",", "lpplsModel", ",", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", 
                    " ", "ti"}], "]"}]}], ";", 
                   RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"\[ScriptCapitalR]", "=", 
                    RowBox[{"nlm", "[", "\"\<FitResiduals\>\"", "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", " ", 
                    RowBox[{"Fit", " ", "an", " ", "AR", 
                    RowBox[{"(", "1", ")"}], " ", "process"}], " ", "*)"}], 
                   "\[IndentingNewLine]", 
                   RowBox[{"ar1Process", "=", 
                    RowBox[{"ARProcess", "[", 
                    RowBox[{"\[Mu]", ",", 
                    RowBox[{"{", "\[Rho]", "}"}], ",", 
                    RowBox[{"\[Sigma]", "^", "2"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"estimatedAR1Model", "=", 
                    RowBox[{"FindProcessParameters", "[", 
                    RowBox[{"\[ScriptCapitalR]", ",", "ar1Process"}], 
                    "]"}]}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{"RSS", "=", 
                   RowBox[{"Total", "[", 
