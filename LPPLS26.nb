    RowBox[{
     RowBox[{"bubblesDate", "[", 
      RowBox[{"[", "bubble", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"bubblesDays", "[", 
      RowBox[{"[", "bubble", "]"}], "]"}], 
     RowBox[{"tc", "/", "lastScaledTc"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
