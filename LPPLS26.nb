Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Export", " ", "bubbles", " ", 
    RowBox[{"data", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"bubbleScaledCsvs", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"base", "<>", "\"\<csv/bubbleScaled-Bitcoin-\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<.tsv\>\""}], 
        ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<time\>\"", ",", "\"\<value\>\""}], "}"}], "}"}], ",",
           "#1"}], "]"}]}], "]"}], "&"}], ",", "bubblesScaled"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"51b692f7-e8bc-491c-9515-7f87ee2db145"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"/Users/mauro/Projects/Bitcoin/csv/bubbleScaled-Bitcoin-1.tsv\"\
\>", ",", "\<\"/Users/mauro/Projects/Bitcoin/csv/bubbleScaled-Bitcoin-2.tsv\"\
\>"}], "}"}]], "Output",
 CellLabel->"Out[44]=",ExpressionUUID->"d0f1cf72-50ec-4586-8e31-8e5e23226d5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Our", " ", "\"\<goodness of fit\>\"", " ", "control", " ", 
    RowBox[{"parameter", ".", " ", "The"}], " ", "smaller", " ", "the", " ", 
    RowBox[{"better", ".", " ", "i", ".", "e", ".", " ", "stricter"}], " ", 
    "hypothesis", " ", "testing", " ", "will", " ", 
    RowBox[{"be", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Empirically", ",", " ", 
    RowBox[{
    "spans", " ", "greater", " ", "than", " ", "0.1", " ", "indicate", " ", 
     "that", " ", "our", " ", "prediction", " ", "is", " ", "not", " ", 
     "very", " ", 
     RowBox[{"reliable", " ", "/", " ", 
      RowBox[{"trustworthy", "."}]}]}]}], " ", "*)"}], 
  RowBox[{"bestSpan", "=", "0.08"}]}]], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"df393f4e-6c47-40b0-8da4-2d74861fd20b"],

Cell[BoxData["0.08`"], "Output",
 CellLabel->"Out[45]=",ExpressionUUID->"7588ec72-2068-4810-a6cc-fb33d7e0286c"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Get", " ", "params", " ", "from", " ", 
    RowBox[{"R", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rInputs", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<bestSpan <- \>\"", "<>", " ", 
       RowBox[{"ToString", "[", "bestSpan", "]"}], "<>", "\"\<\\n\>\"", "<>", 
       "\[IndentingNewLine]", "\"\<bubbleScaled<-read.csv(\\\"\>\"", "<>", 
       RowBox[{"ToString", "[", "#", "]"}], "<>", 
       "\"\<\\\", sep='\\\\t', header=TRUE)\>\"", "<>", "\"\<\\n\>\"", "<>", 
       "\[IndentingNewLine]", 
       "\"\<bubble.lo<-loess(value~time, bubbleScaled, degree=1, \
span=bestSpan)\>\"", "<>", "\"\<\\n\>\"", "<>", "\[IndentingNewLine]", 
       "\"\<pred=predict(bubble.lo, 1, se=TRUE);\>\"", "<>", "\"\<\\n\>\"", "<>",
        "\[IndentingNewLine]", "\"\<bubble.lo$enp\>\"", "<>", "\"\<\\n\>\"", "<>",
