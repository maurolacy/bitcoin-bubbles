Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Scale", " ", "data", " ", "horizontally", " ", "and", " ", "vertically"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"scaleH", "[", "data_", "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"peaks", ",", " ", "first"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Scale", " ", "bubbles", " ", "horizontally", " ", 
       RowBox[{"(", 
        RowBox[{"0", "-", "1"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
        "set", " ", "1", " ", "at", " ", "the", " ", "true", " ", "peaks"}], 
        ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"peaks", "=", 
       RowBox[{
        RowBox[{"MaximalBy", "[", 
         RowBox[{"data", ",", " ", "Last"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"first", " ", "=", " ", 
       RowBox[{"data", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{"first", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"peaks", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{"first", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", "data"}]}]}],
     "\[IndentingNewLine]", "]"}]}]}]], "Input",
