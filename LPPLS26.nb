Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pricePrediction", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"mToPrice", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{"tcToDate", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], "&"}], 
       "/@", "bubbleBest"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ImageSize", "->", "Full"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<BTC Price Evolution (p=\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"selPValues", "[", 
            RowBox[{"[", "index", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}], 
        ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "maxTc"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "bestPrice"}], "}"}]}], "}"}]}], ",", " ", 
        RowBox[{"Ticks", "->", 
         RowBox[{"{", 
          RowBox[{"ticksH", ",", "ticksVPrice"}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Darker", "[", 
          RowBox[{"Blue", ",", " ", ".4"}], "]"}]}], ",", " ", 
        RowBox[{"TicksStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"\"\<Label\>\"", ",", " ", "10"}], "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", "\"\<USD\>\""}]}], "}"}]}], "]"}], ",", 
    " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"mToPrice", "[", 
          RowBox[{
           RowBox[{"lpplsModel", "/.", "fit"}], ",", " ", 
           RowBox[{"tcToDate", "[", "ti", "]"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"ti", "-", "lowCItc"}], "]"}], 
         RowBox[{"(", 
          RowBox[{"bestPrice", "+", "1000"}], ")"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"UnitStep", "[", 
           RowBox[{"ti", "-", "highCItc"}], "]"}], 
          RowBox[{"(", 
           RowBox[{"bestPrice", "+", "1000"}], ")"}]}], "/.", "fit"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
