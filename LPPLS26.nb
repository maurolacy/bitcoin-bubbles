Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Plot", " ", "predicted", " ", "price", " ", "evolution", " ", 
     RowBox[{"(", "USD", ")"}]}], " ", ":"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ticksVPrice", "[", 
     RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"\"\<$\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"IntegerPart", "[", 
           RowBox[{"i", "/", "1000"}], "]"}], "]"}], "<>", "\"\<K\>\""}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "min", ",", " ", "max", ",", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"IntegerPart", "[", 
            RowBox[{"max", "/", "100000"}], "]"}]}], "]"}], "10000"}]}], 
       "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"ticksVPrice", "[", 
    RowBox[{"1", ",", " ", "100000"}], "]"}]}]}]], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"54fbf4fe-b4a6-4af8-af22-b6b70a51a8b5"],

