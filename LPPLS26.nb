Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Convert", " ", "to", " ", "market", " ", "capitalization"}], ",",
     " ", 
    RowBox[{"using", " ", "circulating", " ", "supply", " ", "data"}], ",", 
    " ", 
    RowBox[{"from", " ", 
     RowBox[{"blockchain", ".", "info"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Load", " ", "circulating", " ", "supply", " ", 
    RowBox[{"data", ":", " ", 
     ButtonBox[
      RowBox[{
       RowBox[{"https", ":"}], "//", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"www", ".", "blockchain", ".", "com"}], "/", "charts"}], 
         "/", "total"}], "-", "bitcoins"}]}],
      BaseStyle->"Hyperlink",
      ButtonData->{
        URL["https://www.blockchain.com/charts/total-bitcoins"], None},
      ButtonNote->"https://www.blockchain.com/charts/total-bitcoins"]}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"supplyJsonData", " ", "=", " ", 
    RowBox[{
    "Import", "[", 
     "\"\<https://api.blockchain.info/charts/total-bitcoins?timespan=all&\
sampled=true&metadata=false&daysAverageString=1d&cors=true&format=json\>\"", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"4405809b-fc46-437a-ab4e-b5fba4f328de"],

