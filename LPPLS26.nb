                RowBox[{"{", 
                 RowBox[{"tc", ",", "m", ",", "\[Omega]", ",", 
                  RowBox[{
                   RowBox[{"nlm", "=", 
                    RowBox[{"NonlinearModelFit", "[", 
                    RowBox[{
                    RowBox[{"Select", "[", 
