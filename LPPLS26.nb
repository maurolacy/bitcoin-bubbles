    RowBox[{"Slow", ".", " ", "Shortcut"}], " ", "below"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Now", "[", "]"}], "\[IndentingNewLine]", 
