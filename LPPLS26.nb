Cell[BoxData[{
 RowBox[{
  RowBox[{"target", "=", "1.92"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilon", "=", 
   RowBox[{"1", "/", "10000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"precision", "=", 
   RowBox[{"1", "/", "1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oldSign", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"delta", "=", 
       RowBox[{"bestLL", "-", "lowCILL"}]}], ";", 
