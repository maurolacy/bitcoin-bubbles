                   "maxTc", ",", "stepTc"}], "}"}]}], "]"}], ",", "2"}], 
             "]"}], ",", " ", "Last"}], "]"}], "//", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"#", ",", " ", "1"}], "]"}], "&"}]}]}], ";", 
        RowBox[{"modelParams", "=", 
