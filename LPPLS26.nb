Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Plot", " ", "predicted", " ", "market", " ", "cap", " ", "evolution", 
     " ", 
     RowBox[{"(", "USD", ")"}]}], " ", ":"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fixDate", "[", "brokenDate_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"StringTake", "[", 
      RowBox[{"brokenDate", ",", "2"}], "]"}], "<>", "\"\</\>\"", "<>", 
     RowBox[{"StringTake", "[", 
      RowBox[{"brokenDate", ",", 
       RowBox[{"3", ";;"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ticksH", "[", 
     RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Rotate", "[", 
         RowBox[{
          RowBox[{"fixDate", "[", 
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"$DateStringFormat", "=", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Day\>\"", ",", "\"\<Month\>\"", ",", "\"\</\>\"", ",", 
                 "\"\<YearShort\>\""}], "}"}]}], "}"}], ",", 
             RowBox[{"DatePlus", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"bubblesDate", "[", 
                 RowBox[{"[", "bubble", "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"bubblesDays", "[", 
                 RowBox[{"[", "bubble", "]"}], "]"}], 
                RowBox[{"i", "/", "lastScaledTc"}]}]}], "]"}]}], "]"}], "]"}],
           ",", " ", 
          RowBox[{"\[Pi]", "/", "3"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{
         "t1", ",", "lastScaledTc", ",", "lowCItc", ",", " ", "bestTc", ",", 
          " ", "highCItc"}], "}"}]}], "}"}]}], "]"}]}]}]}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"c207484d-d472-43c8-8f6b-848babe5e612"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ticksVM", "[", 
   RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"\"\<$ \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"i", " ", 
          FractionBox["latestMarketCap", 
           RowBox[{"Exp", "[", "lastScaledM", "]"}]]}], "]"}], "]"}], "<>", 
       "\"\<M\>\""}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "min", ",", " ", "max", ",", "1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"e814fab3-e5dd-4d4c-bf0e-d6f44f273bf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"marketCapPrediction", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
       "bubbleBest"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ImageSize", "->", "Full"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<BTC Market Cap Evolution (p=\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"selPValues", "[", 
            RowBox[{"[", "index", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}], 
        ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "maxTc"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Exp", "[", "bestM", "]"}]}], "}"}]}], "}"}]}], ",", " ", 
        RowBox[{"Ticks", "->", 
         RowBox[{"{", 
          RowBox[{"ticksH", ",", "ticksVM"}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Darker", "[", 
          RowBox[{"Blue", ",", " ", ".4"}], "]"}]}], ",", " ", 
        RowBox[{"TicksStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"\"\<Label\>\"", ",", " ", "10"}], "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", "\"\<USD\>\""}]}], "}"}]}], "]"}], ",", 
    " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{"lpplsModel", "/.", "fit"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"ti", "-", "lowCItc"}], "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{"bestM", "+", "1"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"UnitStep", "[", 
           RowBox[{"ti", "-", "highCItc"}], "]"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"bestM", "+", "1"}], "]"}]}], "/.", "fit"}], ",", " ", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"lowCItc", "-", "ti"}], "]"}], 
         RowBox[{"Exp", "[", "lowCIM", "]"}]}], ",", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"bestTc", "-", "ti"}], "]"}], 
         RowBox[{"Exp", "[", "bestM", "]"}]}], ",", 
        RowBox[{
         RowBox[{"UnitStep", "[", 
          RowBox[{"lastScaledTc", "-", "ti"}], "]"}], 
         RowBox[{"Exp", "[", "lastScaledM", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"ti", ",", " ", "0", ",", " ", 
        RowBox[{"maxTc", "+", 
         RowBox[{"1", "/", "10"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"colors", "[", 
           RowBox[{"[", "bestIndex", "]"}], "]"}], ",", "Orange", ",", " ", 
          "Orange", ",", " ", "Orange", ",", " ", 
          RowBox[{"colors", "[", 
           RowBox[{"[", "bestIndex", "]"}], "]"}], ",", " ", 
          RowBox[{"Darker", "[", 
           RowBox[{"Blue", ",", " ", ".5"}], "]"}]}], "}"}]}], "}"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"29e49a21-912e-4e97-b665-6d38e5a0338d"],

