Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "price", " ", "is", " ", "the", " ", "ratio", " ", "of", " ", 
    "the", " ", "market", " ", "cap", " ", 
    RowBox[{"(", 
     RowBox[{"in", " ", "Millions", " ", "USD"}], ")"}], " ", "to", " ", 
    "the", " ", 
    RowBox[{"(", "predicted", ")"}], " ", "supply", " ", "at", " ", "the", 
    " ", 
    RowBox[{"date", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"mToPrice", "[", 
    RowBox[{"m_", ",", " ", "date_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"mToMarketCap", "[", "m", "]"}], 
    RowBox[{
     SuperscriptBox["10", "7"], "/", 
     RowBox[{"supplyFunction", "[", 
      RowBox[{"UnixTime", "[", "date", "]"}], "]"}]}]}]}]}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"f16c0c4e-da0e-4dac-bac1-0ef6975d5c9b"],

