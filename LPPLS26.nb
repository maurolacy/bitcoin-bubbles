Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Show", " ", "some", " ", "simulations", " ", "and", " ", "data", " ", 
    "points"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"showSims", "=", "3"}], ";"}], "\[IndentingNewLine]", 
