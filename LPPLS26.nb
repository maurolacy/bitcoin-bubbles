            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{";;", "showPoints"}], "]"}], "]"}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"selPaths", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{";;", "showSims"}], ",", 
            RowBox[{";;", "showPoints"}]}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "Thick", ",", " ", "Dashed", ",", " ", "Dashed", ",", " ", 
          "Dashed"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<data\>\"", ",", "\"\<simulations\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "selN"}], "}"}]}], "]"}]}]}]], "Input",
