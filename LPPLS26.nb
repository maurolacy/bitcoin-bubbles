Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "estimated", " ", "number", " ", "of", " ", "parameters", " ", 
    "of", " ", "the", " ", "sample", " ", "selections", " ", 
    RowBox[{"fits", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"From", " ", 
     RowBox[{"R", "'"}], "s", " ", "loess"}], ",", " ", 
    RowBox[{"using", " ", "list", " ", "of", " ", 
     RowBox[{"(", "selections", ")"}], " ", "effective", " ", 
     RowBox[{"dfs", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"selRInputs", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<bestSpan <- \>\"", "<>", " ", 
       RowBox[{"ToString", "[", "bestSpan", "]"}], "<>", "\"\<\\n\>\"", "<>", 
       "\[IndentingNewLine]", "\"\<bubbleScaled<-read.csv(\\\"\>\"", "<>", 
       RowBox[{"ToString", "[", "#", "]"}], "<>", 
       "\"\<\\\", sep='\\\\t', header=TRUE)\>\"", "<>", "\"\<\\n\>\"", "<>", 
       "\[IndentingNewLine]", 
       "\"\<bubble.lo<-loess(value~time, bubbleScaled, degree=1, \
span=bestSpan)\>\"", "<>", "\"\<\\n\>\"", "<>", "\[IndentingNewLine]", 
       "\"\<pred=predict(bubble.lo, 1, se=TRUE);\>\"", "<>", "\"\<\\n\>\"", "<>",
        "\[IndentingNewLine]", "\"\<bubble.lo$enp\>\"", "<>", "\"\<\\n\>\"", "<>",
        "\[IndentingNewLine]", "\"\<pred$df\>\"", "<>", "\"\<\\n\>\"", "<>", 
       "\[IndentingNewLine]", "\"\<sum(bubble.lo$residuals^2)\>\"", "<>", 
       "\"\<\\n\>\"", "<>", "\[IndentingNewLine]", "\"\<bubble.lo$s\>\"", 
       "<>", "\"\<\\n\>\"", "<>", "\[IndentingNewLine]", 
       "\"\<pred$se.fit\>\""}], "&"}], "/@", "selBubbleScaledCsvs"}]}], 
   ";"}]}]], "Input",
 CellLabel->
