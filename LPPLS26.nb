Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", " ", 
    RowBox[{"Characterize", " ", "error", " ", 
     RowBox[{"variance", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "2.", "a", " ", "Bootstrap", " ", "the", " ", "residuals", " ", "from", 
    " ", "step", " ", "1", " ", "and", " ", "feed", " ", "them", " ", 
    "through", " ", "the", " ", "fitted", " ", "AR", 
    RowBox[{"(", "1", ")"}], " ", "to", " ", "simulate", " ", 
    RowBox[{"errors", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"selNPointss", "=", 
     RowBox[{"Length", "/@", "selNp\[ScriptCapitalR]s"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nSims", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selSims", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"RandomFunction", "[", 
        RowBox[{
         RowBox[{"selEstimatedProcesses", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"selNPointss", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "}"}], ",", 
         "nSims"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "selN"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"selNp\[ScriptCapitalR]sPlots", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"selNPointss", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"selNp\[ScriptCapitalR]s", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", 
              RowBox[{"selNPointss", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "selN"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"selPaths", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<Paths\>\"", "]"}], "&"}], "/@", "selSims"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"202ffb9d-2cfd-434e-b9da-42b72786f7b3"],

