Cell[BoxData[
 RowBox[{
  RowBox[{"scaleV", "[", "data_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"min", ",", " ", "max"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Rescale", " ", "vertically"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"min", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"Last", " ", "/@", "data"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"max", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Last", " ", "/@", "data"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "min"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"max", "-", "min"}], ")"}]}]}], "}"}], "&"}], "/@", 
      "data"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"f1fea269-d681-42ad-879c-f59e183dd578"],

