Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"2.", " ", "Market", " ", "cap", " ", 
    RowBox[{"data", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"marketCapImport", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
      "\"\<https://bitinfocharts.com/comparison/bitcoin-marketcap.html#log&\
alltime\>\"", ",", " ", "\"\<text\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"marketCapCase", "=", 
     RowBox[{
      RowBox[{"StringCases", "[", 
       RowBox[{"marketCapImport", ",", " ", 
        RowBox[{
        "RegularExpression", "[", "\"\<\\[\\[new Date.*\\]\\]\>\"", "]"}]}], 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"marketCapReplace", "=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{"marketCapCase", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<new Date(\\\"\>\"", "->", " ", "\"\<\>\""}], ",", " ", 
         RowBox[{"\"\<\\\")\>\"", "->", " ", "\"\<\>\""}], ",", " ", 
         RowBox[{"\"\<],\>\"", "->", " ", "\"\<\\n\>\""}], ",", " ", 
         RowBox[{"\"\<[\>\"", "->", " ", "\"\<\>\""}], ",", " ", 
         RowBox[{"\"\<]\>\"", "->", " ", "\"\<\>\""}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"marketCapSplit", "=", 
     RowBox[{"StringSplit", "[", 
      RowBox[{"marketCapReplace", ",", " ", "\"\<\\n\>\""}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"bdf45d74-ccdc-4d7c-9190-08f4b6034039"],

