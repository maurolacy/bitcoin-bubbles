Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Scale", " ", "data", " ", "horizontally", " ", "and", " ", "vertically"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"scaleH", "[", "data_", "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"peaks", ",", " ", "first"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Scale", " ", "bubbles", " ", "horizontally", " ", 
       RowBox[{"(", 
        RowBox[{"0", "-", "1"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
        "set", " ", "1", " ", "at", " ", "the", " ", "true", " ", "peaks"}], 
        ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"peaks", "=", 
       RowBox[{
        RowBox[{"MaximalBy", "[", 
         RowBox[{"data", ",", " ", "Last"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"first", " ", "=", " ", 
       RowBox[{"data", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{"first", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"peaks", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{"first", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", "data"}]}]}],
     "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"12ae8436-2d17-4888-abe1-bc0d29a6e7ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scaleV", "[", "data_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"min", ",", " ", "max"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Rescale", " ", "vertically"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"min", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"Last", " ", "/@", "data"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"max", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Last", " ", "/@", "data"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "min"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"max", "-", "min"}], ")"}]}]}], "}"}], "&"}], "/@", 
      "data"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"f1fea269-d681-42ad-879c-f59e183dd578"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bubblesScaled", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"scaleV", "[", 
       RowBox[{"scaleH", "[", "#", "]"}], "]"}], "&"}], "/@", " ", 
     "bubbles"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"#", "[", 
