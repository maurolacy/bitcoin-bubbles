Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Export", " ", "bubbles", " ", 
    RowBox[{"data", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"bubbleScaledCsvs", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"base", "<>", "\"\<csv/bubbleScaled-Gold-\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<.tsv\>\""}], 
        ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<time\>\"", ",", "\"\<value\>\""}], "}"}], "}"}], ",",
           "#1"}], "]"}]}], "]"}], "&"}], ",", "bubblesScaled"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"51b692f7-e8bc-491c-9515-7f87ee2db145"],

