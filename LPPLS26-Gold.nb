  RowBox[{"(*", " ", 
   RowBox[{"Parametric", " ", 
    RowBox[{"residuals", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fullFit", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"lpplsModel", "/.", 
      RowBox[{"fits", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"ti", "->", " ", "t"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p\[ScriptCapitalR]s", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bubbleScaled", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"fullFit", "[", 
         RowBox[{
          RowBox[{"bubbleScaled", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "bubbleScaled", "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
