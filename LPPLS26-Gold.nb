     RowBox[{"StringTake", "[", 
      RowBox[{"brokenDate", ",", "2"}], "]"}], "<>", "\"\</\>\"", "<>", 
     RowBox[{"StringTake", "[", 
      RowBox[{"brokenDate", ",", 
       RowBox[{"3", ";;"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
